[Unit]
Description=Metro Chat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bamboo-forest
Group=bamboo-forest
WorkingDirectory=/opt/bamboo-forest/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3212
Environment=METRO_STATE_DIR=/var/lib/bamboo-forest
StateDirectory=bamboo-forest
StateDirectoryMode=0700
EnvironmentFile=-/opt/bamboo-forest/subway.env
ExecStart=/opt/mandragora/node/bin/node --max-old-space-size=64 server.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=128M
CPUQuota=50%
UMask=0077

[Install]
WantedBy=multi-user.target
